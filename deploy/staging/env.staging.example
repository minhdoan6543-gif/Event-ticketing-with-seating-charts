# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG STAGING (.env.staging.example)
# Dự án: Bán vé sự kiện có sơ đồ ghế (User Story S-01)
# ==============================================================================

# 1. Cơ sở dữ liệu PostgreSQL Staging (Được cô lập trong mạng Docker nội bộ)
POSTGRES_USER=staging_ticket_user
POSTGRES_PASSWORD=StagingSecureDbPassword2026!Complex_Generate_Real_One_Here
POSTGRES_DB=ticket_staging_db

# 2. Redis Staging (Được cô lập trong mạng Docker nội bộ)
REDIS_PASSWORD=StagingRedisPassword2026!Complex_Generate_Real_One_Here

# 3. Cổng Reverse Proxy phục vụ Staging
STAGING_HTTP_PORT=80

# 4. Registry & Image Tags
REGISTRY=ghcr.io
REPO_NAME=your-org-or-username/ticket-booking

# 5. Hình ảnh Docker cho Slot Blue và Green (Được cập nhật tự động khi deploy)
BACKEND_IMAGE_BLUE=ghcr.io/your-org-or-username/ticket-booking/backend:staging
FRONTEND_IMAGE_BLUE=ghcr.io/your-org-or-username/ticket-booking/frontend:staging
BACKEND_IMAGE_GREEN=ghcr.io/your-org-or-username/ticket-booking/backend:staging
FRONTEND_IMAGE_GREEN=ghcr.io/your-org-or-username/ticket-booking/frontend:staging
