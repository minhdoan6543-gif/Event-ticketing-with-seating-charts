# ==============================================================================
# Bán Vé Sự Kiện Có Sơ Đồ Ghế - File Môi Trường Mẫu (.env.example)
# Sao chép file này thành .env trên máy local: cp .env.example .env
# TUYỆT ĐỐI KHÔNG commit file .env chứa mật khẩu thật lên Git repository!
# ==============================================================================

# 1. Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_USER=ticket_user
POSTGRES_PASSWORD=TicketSecureDevPassword2026!
POSTGRES_DB=ticket_booking_db
POSTGRES_PORT=5432

# 2. Cấu hình Redis Cache
REDIS_PASSWORD=RedisSecureDevPassword2026!
REDIS_PORT=6379

# 3. Cấu hình Backend (ASP.NET Core Web API)
# Định dạng cấu hình ConnectionStrings trong ASP.NET Core qua biến môi trường (dùng 2 dấu gạch dưới __)
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=ticket_booking_db;Username=ticket_user;Password=TicketSecureDevPassword2026!;Timeout=15;Command Timeout=30
ConnectionStrings__Redis=redis:6379,password=RedisSecureDevPassword2026!,abortConnect=false,connectTimeout=5000

# 4. Cấu hình Frontend (React + Vite)
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:5000

# 5. Cấu hình Staging / Production (Docker Registry & Ports)
DOCKER_REGISTRY=ghcr.io
IMAGE_TAG=latest
STAGING_PORT=80
